rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    // Un membre est un utilisateur dont l'uid figure dans memberUids du couple.
    // memberUids est maintenu à la création, à la jointure et à la reprise d'un
    // placeholder (voir CoupleSetupScreen), et resynchronisé au chargement
    // depuis `members` (FinanceContext).
    //
    // Un document SANS memberUids était auparavant toléré — considéré accessible
    // à tout utilisateur authentifié — pour ne pas verrouiller les espaces créés
    // avant l'introduction du champ. Cette tolérance ouvrait en lecture ET en
    // écriture l'intégralité d'un couple, transactions comprises, à qui devinait
    // son identifiant.
    //
    // Elle est retirée : plus aucun document n'est dans ce cas (vérifié), et
    // `allow create` ci-dessous exige que l'appelant figure dans le memberUids
    // du document créé — il est donc désormais impossible d'en créer un sans.
    // L'absence du champ vaut maintenant refus, pour tout le monde.
    function isCoupleMember(coupleId) {
      return isSignedIn()
        && request.auth.uid in coupleData(coupleId).memberUids;
    }

    // Chaque utilisateur authentifié peut lire/modifier son propre profil.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      // Lecture/écriture réservées aux membres du couple.
      //
      // La jointure par code ne passe PLUS par ici : elle est entièrement
      // traitée par la Cloud Function `joinCouple` (admin SDK), qui vérifie la
      // fenêtre de validité de l'invitation et la limite de 2 membres.
      //
      // Une clause `|| request.auth.uid in request.resource.data.memberUids`
      // existait ici pour permettre à un non-membre de s'auto-ajouter. Elle
      // était devenue inutile — toutes les écritures clientes de memberUids
      // sont faites par un membre existant — et elle était dangereuse : un
      // inconnu ayant deviné le code pouvait écrire `memberUids: [sonUid]`,
      // s'octroyer l'accès ET verrouiller les propriétaires légitimes dehors,
      // sans jamais passer par les contrôles de la Cloud Function.
      allow read, delete: if isCoupleMember(coupleId);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isCoupleMember(coupleId);

      match /transactions/{transactionId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Connexions bancaires : contiennent les access_token Plaid. Seules les
      // Cloud Functions (admin SDK, qui contourne ces règles) y accèdent. Aucun
      // accès client, en lecture comme en écriture.
      match /bankConnections/{connectionId} {
        allow read, write: if false;
      }

      // Instantanés quotidiens du patrimoine, un document par jour (l'id EST la
      // date). Lisibles par les membres : le tableau d'évolution les interroge
      // par plage de dates. Écriture INTERDITE au client — ils sont produits par
      // la fonction planifiée `recordNetWorthSnapshots`, qui passe par l'admin
      // SDK et contourne donc ces règles.
      //
      // Ce n'est pas une précaution de principe : un instantané est un chiffre
      // historique que rien ne recalcule. Autoriser le client à en écrire, c'est
      // lui permettre de réécrire son propre passé, et rendre le tableau
      // d'évolution invérifiable.
      match /netWorthSnapshots/{snapshotDate} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }
    }

    // Correspondance item Plaid → couple/asset, écrite/lue uniquement par les
    // Cloud Functions (le webhook s'en sert pour router). Jamais côté client.
    match /plaidItems/{itemId} {
      allow read, write: if false;
    }
  }
}
