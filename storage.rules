rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Pourquoi PAS de vérification d'appartenance au couple ────────────────
    // Une première version cloisonnait les reçus par couple, en lisant
    // `memberUids` dans Firestore depuis ces règles (`firestore.get`). Ça n'a
    // jamais fonctionné sur ce projet : l'appel inter-services échoue à
    // l'évaluation, ce qui fait échouer TOUTE la règle et refuse tout — sans
    // aucune erreur au déploiement, les noms de fonctions inter-services
    // n'étant pas résolus à la compilation.
    //
    // Le cloisonnement par couple était de toute façon inutile : rien dans
    // l'app ne lit un reçu par son chemin. `TransactionsScreen` les affiche
    // depuis `receiptURL`, une URL de téléchargement à jeton qui court-circuite
    // ces règles. Aucun accès SDK en lecture n'est donc nécessaire, y compris
    // pour le/la partenaire.
    //
    // On range donc par AUTEUR DU DÉPÔT. C'est plus simple, sans dépendance à
    // Firestore ni à un rôle IAM, et plus strict que le cloisonnement visé.
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photo de profil : chacun n'écrit que la sienne, le nom du fichier étant
    // `{uid}.jpg`. Avant, n'importe quel compte authentifié pouvait ÉCRASER la
    // photo de n'importe qui.
    //
    // Le partenaire n'a besoin d'aucun accès ici : la photo est affichée depuis
    // l'URL de téléchargement stockée sur le doc couple, qui porte son propre
    // jeton et ne passe pas par ces règles.
    match /profiles/{fileName} {
      allow read, write: if isSignedIn() && fileName == request.auth.uid + '.jpg';
    }

    // Reçus, rangés par UID de l'auteur du dépôt. Ce sont des pièces
    // financières : personne d'autre n'y accède par le SDK. Avant, tout compte
    // authentifié pouvait lire le reçu de n'importe qui.
    match /receipts/{uid}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Note sur l'ancien emplacement à plat (`receipts/{txId}.jpg`) : il n'a
    // volontairement AUCUNE règle. Le chemin ne dit pas à quel couple le
    // fichier appartient, on ne peut donc pas y vérifier l'appartenance ;
    // l'absence de règle vaut refus, ce qui ferme l'accès par le SDK.
    //
    // Les reçus déjà enregistrés continuent de s'afficher : l'app les rend
    // depuis `receiptURL`, une URL à jeton qui court-circuite ces règles. Ces
    // fichiers restent donc lisibles par qui possède l'URL — les règles ne
    // peuvent pas révoquer un jeton déjà émis. Pour vraiment les reprendre en
    // main, il faut les redéposer sous le nouveau chemin et supprimer les
    // anciens objets.
  }
}
